# Normalize line endings in the repository; check out LF everywhere.
* text=auto eol=lf

# Windows shells expect CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.node binary
