{
  "name": "webyou",
  "version": "1.0.0",
  "description": "WebYou — a friendly desktop IDE for learning to build websites",
  "main": "./out/main/index.js",
  "author": "WebYou",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "fetch-php": "node scripts/fetch-php.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "theme": "node scripts/generate-theme.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && npm run licenses && electron-builder --win zip",
    "dist:linux": "npm run build && npm run licenses && electron-builder --linux",
    "dist:dir": "npm run build && npm run licenses && electron-builder --win dir"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "htmlhint": "^1.8.0",
    "i18next": "^25.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
  }
}
